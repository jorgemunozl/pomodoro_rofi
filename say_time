#!/usr/bin/env python3
"""Announce the time every 5 minutes using pre-recorded mp3s.

Offline — no gtts, no internet. Plays the matching clip from
~/Videos/study/sound_effects/ (say_time_HH_MM_AM/PM.mp3) exactly at
each 5-minute mark (HH:00, HH:05, HH:10, …).

Usage:
    say_time                       # align to next 5-min mark, then announce
    say_time --once                # announce the current time once (test)
    say_time --time "11:55 AM"     # play that clip and exit (test hook)
    say_time --dir /path/to/clips  # custom clips directory
    say_time --volume 100          # mpv volume
"""

import argparse
import subprocess
import sys
import time
from pathlib import Path

INTERVAL = 5 * 60  # seconds — announce at every 5-minute mark
DEFAULT_DIR = Path.home() / "Videos" / "study" / "sound_effects"
DEFAULT_VOLUME = 130


def clip_path(directory: Path, t: time.struct_time) -> Path:
    """Map a time to its clip file (say_time_HH_MM_AM/PM.mp3)."""
    hour = t.tm_hour % 12 or 12  # 1..12 (12-hour clock)
    ampm = "AM" if t.tm_hour < 12 else "PM"
    return directory / f"say_time_{hour:02d}_{t.tm_min:02d}_{ampm}.mp3"


def play(path: Path, volume: int) -> bool:
    """Play a clip with mpv. Returns False if the clip or mpv is missing."""
    if not path.exists():
        return False
    try:
        subprocess.Popen(
            ["mpv", "--no-terminal", "--no-video", f"--volume={volume}", str(path)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        print("say_time: mpv not found — install mpv to play audio",
              file=sys.stderr)
        return False
    return True


def announce(directory: Path, volume: int, t: time.struct_time | None = None) -> None:
    """Say the time for *t* (default: now) and log the result."""
    t = t or time.localtime()
    clip = clip_path(directory, t)
    ok = play(clip, volume)
    status = "✓" if ok else "✗"
    print(f"{time.strftime('%H:%M:%S')} {status} {clip.name}", flush=True)


def next_boundary(now: float | None = None) -> int:
    """Epoch second of the next 5-minute mark (>= *now*)."""
    now = int(now if now is not None else time.time())
    return now + (-now) % INTERVAL


def main() -> None:
    ap = argparse.ArgumentParser(
        description="Announce the time every 5 minutes from local mp3 clips."
    )
    ap.add_argument(
        "-d", "--dir", default=str(DEFAULT_DIR),
        help=f"directory with say_time_* clips (default {DEFAULT_DIR})",
    )
    ap.add_argument(
        "-v", "--volume", type=int, default=DEFAULT_VOLUME,
        help=f"mpv volume (default {DEFAULT_VOLUME})",
    )
    ap.add_argument(
        "--once", action="store_true",
        help="announce the current time once and exit (only works at "
             "5-minute marks)",
    )
    ap.add_argument(
        "--time", metavar='"HH:MM AM"',
        help="play the clip for a specific time and exit (testing aid)",
    )
    args = ap.parse_args()
    directory = Path(args.dir)

    # Test hook: play one specific clip and exit
    if args.time:
        try:
            t = time.strptime(args.time, "%I:%M %p")
        except ValueError:
            print(f"say_time: cannot parse --time {args.time!r} "
                  f'(use e.g. "11:55 AM")', file=sys.stderr)
            sys.exit(1)
        announce(directory, args.volume, t)
        return

    if args.once:
        announce(directory, args.volume)
        return

    # Main loop: announce at each 5-minute mark, then advance to the next one.
    target = next_boundary()
    next_at = time.localtime(target)
    print(f"say_time: next announcement at "
          f"{time.strftime('%I:%M', next_at)} {time.strftime('%p', next_at)}"
          f" — Ctrl+C to stop", flush=True)
    try:
        while True:
            delay = target - time.time()
            if delay > 0:
                time.sleep(delay)
            announce(directory, args.volume)
            # Jump to the next mark, skipping any we slept through, so a late
            # wake-up never re-announces the same mark in a tight loop.
            target = max(target + INTERVAL, next_boundary())
    except KeyboardInterrupt:
        print("\nsay_time: stopped")


if __name__ == "__main__":
    main()
