#!/usr/bin/env python3
"""Announce the time every N minutes using gTTS + mpv.

Standalone — no pomodoro dependencies. Works on the laptop and on
Termux (Android). Requires `gtts-cli` (pip install gTTS) and `mpv`,
plus internet access for speech generation.

Usage:
    say_time                       # announce now, then every 5 minutes
    say_time --interval 600        # every 10 minutes
    say_time --once                # single announcement (handy for testing)
    say_time --phrase "It is {time}, keep going" --volume 100
"""

import argparse
import subprocess
import sys
import tempfile
import time
from pathlib import Path

DEFAULT_INTERVAL = 5 * 60  # seconds
DEFAULT_PHRASE = "Attention, the time is {time}"
DEFAULT_VOLUME = 130


def current_time() -> str:
    """Current time as "HH:MM AM/PM" (e.g. "10:30 AM")."""
    return time.strftime("%I:%M %p")


def speak(phrase: str, volume: int) -> bool:
    """Generate speech with gtts-cli and play it with mpv.

    Returns True on success, False on any failure (missing tools,
    no internet, …) — the loop keeps running either way.
    """
    out = Path(tempfile.gettempdir()) / "say_time.mp3"
    try:
        subprocess.run(
            ["gtts-cli", phrase, "--output", str(out)],
            capture_output=True,
            timeout=30,
        )
    except FileNotFoundError:
        print("say_time: gtts-cli not found — install with 'pip install gTTS'",
              file=sys.stderr)
        return False
    except subprocess.TimeoutExpired:
        print("say_time: gtts-cli timed out — no internet?", file=sys.stderr)
        return False

    if not out.exists() or out.stat().st_size == 0:
        print("say_time: no speech generated (check internet)", file=sys.stderr)
        return False

    try:
        subprocess.Popen(
            ["mpv", "--no-terminal", "--no-video", f"--volume={volume}", str(out)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        print("say_time: mpv not found — install mpv to play audio",
              file=sys.stderr)
        return False
    return True


def announce(phrase: str, volume: int) -> None:
    """Say the time once and log it."""
    text = phrase.format(time=current_time())
    ok = speak(text, volume)
    print(f"{time.strftime('%H:%M:%S')} {'✓' if ok else '✗'} {text}", flush=True)


def main() -> None:
    ap = argparse.ArgumentParser(
        description="Announce the time every N minutes via gTTS + mpv."
    )
    ap.add_argument(
        "-i", "--interval", type=int, default=DEFAULT_INTERVAL,
        help=f"seconds between announcements (default {DEFAULT_INTERVAL})",
    )
    ap.add_argument(
        "-v", "--volume", type=int, default=DEFAULT_VOLUME,
        help=f"mpv volume (default {DEFAULT_VOLUME})",
    )
    ap.add_argument(
        "-p", "--phrase", default=DEFAULT_PHRASE,
        help='phrase template; {time} is replaced with "HH:MM AM/PM"',
    )
    ap.add_argument(
        "--once", action="store_true",
        help="announce once and exit",
    )
    args = ap.parse_args()

    announce(args.phrase, args.volume)
    if args.once:
        return

    print(f"say_time: announcing every {args.interval}s — Ctrl+C to stop")
    try:
        while True:
            time.sleep(args.interval)
            announce(args.phrase, args.volume)
    except KeyboardInterrupt:
        print("\nsay_time: stopped")


if __name__ == "__main__":
    main()
